{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=bookrent;Username=bookrent;Password=CHANGE_ME;Include Error Detail=false;Maximum Pool Size=8",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Cache": {
    "DefaultTtl": "00:05:00",
    "InstanceName": "bookrent:"
  },
  "Loans": {
    "DefaultLoanPeriodDays": 14
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
