# Copie para .env e ajuste conforme necessario: docker compose le este arquivo automaticamente.
# O .env NAO deve ser versionado. Os valores abaixo sao apenas para desenvolvimento local.

POSTGRES_DB=bookrent
POSTGRES_USER=bookrent
POSTGRES_PASSWORD=bookrent
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Observabilidade. Ajuste se as portas ja estiverem ocupadas na sua maquina —
# por exemplo, para rodar duas stacks do projeto lado a lado.
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
